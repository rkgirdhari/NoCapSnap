<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.capsnap_app" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Paint the brand base before the WebView loads, so launch never flashes white. -->
        <item name="android:windowBackground">@color/capsnap_royal_purple</item>
        <item name="android:statusBarColor">@color/capsnap_royal_purple</item>
        <item name="android:navigationBarColor">@color/capsnap_royal_purple</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/capsnap_gold</item>
    </style>
</resources>
