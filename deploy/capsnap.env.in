# CapSnap server settings (W3b). Installed as /etc/capsnap/capsnap.env, root:capsnap 0640.
# Changing CAPSNAP_PUBLIC_BASE_URL breaks every guest QR already printed or shown.
CAPSNAP_PUBLIC_BASE_URL=https://@DOMAIN@
CAPSNAP_BIND=@UPSTREAM@
CAPSNAP_DATA_DIR=/var/lib/capsnap
# Who privacy requests go to; shown on https://@DOMAIN@/privacy. Set before the Play listing (W5).
#CAPSNAP_PRIVACY_CONTACT=
