# CapSnap guest portal and staff API for @DOMAIN@ (W3b).
# Generated by deploy/install.sh; edit the template, not this file.
#
# - Only this block faces the internet. The server listens on @UPSTREAM@ (loopback).
# - The access log has no client addresses and no query strings. Guest tokens travel in
#   the URL fragment, which browsers never send, so they cannot appear here either.

log_format capsnap_noaddr '$time_iso8601 "$request_method $uri" $status $body_bytes_sent $request_time';

server {
    listen 80;
    listen [::]:80; # ipv6
    server_name @DOMAIN@;
    server_tokens off;
    access_log /var/log/nginx/capsnap.access.log capsnap_noaddr;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# BEGIN tls
server {
    listen 443 ssl;
    listen [::]:443 ssl; # ipv6
    server_name @DOMAIN@;
    server_tokens off;
    access_log /var/log/nginx/capsnap.access.log capsnap_noaddr;

    ssl_certificate @CERT@;
    ssl_certificate_key @KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:capsnap_tls:1m;
    ssl_session_timeout 1d;

    # nginx's default is 1 MB; the server accepts photos up to 10 MiB.
    client_max_body_size 10m;

    # This host only; the server itself sets CSP and the other headers.
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://@UPSTREAM@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }
}
# END tls
