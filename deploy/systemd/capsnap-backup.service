# CapSnap backup (W4a): one encrypted snapshot, run by capsnap-backup.timer.
# Installed by deploy/install.sh as /etc/systemd/system/capsnap-backup.service.

[Unit]
Description=CapSnap encrypted backup (copy 1 of 3)
After=capsnap.service

[Service]
Type=oneshot
User=capsnap
Group=capsnap
EnvironmentFile=/etc/capsnap/capsnap.env
ExecStart=/usr/local/sbin/capsnap-backup run
TimeoutStartSec=1h

# The data directory (read, and the failure marker) and the backup directory.
StateDirectory=capsnap capsnap-backup
StateDirectoryMode=0700
WorkingDirectory=/var/lib/capsnap
UMask=0077
LogNamespace=capsnap
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
