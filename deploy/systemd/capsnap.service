# CapSnap server: staff API and guest feedback portal (W3b).
# Installed by deploy/install.sh as /etc/systemd/system/capsnap.service.
# Only nginx faces the internet; the server listens on CAPSNAP_BIND (127.0.0.1).

[Unit]
Description=CapSnap server (staff API and guest feedback portal)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=capsnap
Group=capsnap
EnvironmentFile=/etc/capsnap/capsnap.env
ExecStart=/var/www/capsnap/current/capsnap-server serve
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s

# Data (SQLite database and photos) lives here, never under /var/www/capsnap.
StateDirectory=capsnap
StateDirectoryMode=0700
WorkingDirectory=/var/lib/capsnap
UMask=0077

# Logs go to their own journal namespace, kept 30 days (Spec §6), without
# changing retention for anything else on the box. Read them with
# `journalctl --namespace=capsnap`.
LogNamespace=capsnap

# Sandboxing. The server needs its data directory and the network (the staff API,
# and ONB-1 fetching a restaurant's own website); nothing else.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
