# Scripts and templates that run on Linux must keep LF line endings, even when
# checked out on Windows (CRLF breaks bash with "$'\r': command not found").
*.sh            text eol=lf
*.in            text eol=lf
*.service       text eol=lf
deploy/bin/*    text eol=lf
deploy/systemd/* text eol=lf
deploy/nginx/*  text eol=lf
