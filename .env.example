# API
PORT=3000
DATABASE_URL=postgresql://capsnap:capsnap@localhost:5432/capsnap
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me

# Storage — "local" writes to services/api/.data/uploads and serves it at
# ${API_URL}/files; "s3" uploads to S3_BUCKET (served via CLOUDFRONT_DOMAIN if set).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=nocapsnap-photos
CLOUDFRONT_DOMAIN=
# Optional S3-compatible endpoint (MinIO, Cloudflare R2, LocalStack)
S3_ENDPOINT=

# App
# Guest review QR codes encode ${APP_URL}/r/<token>
APP_URL=https://app.nocapsnap.com
API_URL=http://localhost:3000
# The mobile app reads EXPO_PUBLIC_* from apps/mobile/.env, not this file.

# Company
COMPANY_NAME="Hammurabi Coding Company LLC"
FOUNDER_NAME="R. K. Girdhari"
